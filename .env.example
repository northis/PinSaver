# Server configuration
HOST=0.0.0.0
PORT=8000

# Docker (docker-compose.yml reads this file for its ${...} substitutions)
# Host port and the address Traefik connects to over the SoftEther VPN.
PINSAVER_PORT=8000
PINSAVER_BIND_ADDR=10.77.77.21
# Host directory mounted into the container as /data: the archive (database + originals +
# backups). Default "." is the repository root, where the host scripts keep them too.
PINSAVER_HOST_DATA_DIR=.
# Maintenance page (a second port of the same process): archive totals, a full archive
# download (database + images) and the incremental backup. It can hand out everything, so it
# is published on local addresses only. PINSAVER_ADMIN_PORT is the port on the host; inside
# the container the listener is always 8001. PINSAVER_ADMIN_BIND_ADDR is the host address it
# is published on: 127.0.0.1 means this machine only, 10.77.77.21 opens it over the VPN.
PINSAVER_ADMIN_PORT=8001
PINSAVER_ADMIN_BIND_ADDR=127.0.0.1
# Without Docker (`python src/server.py`) there is no publish step: the server binds the
# maintenance listener itself on these (PINSAVER_ADMIN_PORT=0 turns the page off):
# PINSAVER_ADMIN_HOST=127.0.0.1
# PINSAVER_ADMIN_PORT=8001
# Repository link in the build badge; empty means the git remote or the built-in default.
# PINSAVER_REPO_URL=

# Build metadata: deploy/windows/update.ps1 passes these to the build, and they are only
# needed when the image is built outside a git checkout (see the Dockerfile).
# PINSAVER_COMMIT=
# PINSAVER_COMMIT_DATE=
# PINSAVER_VERSION=
# PINSAVER_CREATED=
